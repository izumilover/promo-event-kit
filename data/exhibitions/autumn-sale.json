{
  "id": "autumn-sale",
  "title": "가을맞이 소모품 특가전",
  "period": { "start": "2026-10-01", "end": "2026-10-31" },
  "theme": { "accent": "#e4002b" },
  "sections": [
    {
      "type": "heroBanner",
      "id": "hero",
      "props": {
        "title": "최대 30% 할인",
        "subtitle": "가을맞이 소모품 특가전",
        "periodLabel": "2026.10.1 ~ 2026.10.31",
        "image": { "pc": "/globe.svg", "mo": "/window.svg", "alt": "가을 특가" },
        "cta": { "label": "지금 보기", "href": "#products" }
      }
    },
    {
      "type": "countdownTimer",
      "id": "countdown",
      "props": {
        "endAt": "2026-10-31T23:59:59+09:00",
        "endedLabel": "이벤트가 종료되었습니다"
      }
    },
    {
      "type": "anchorTabs",
      "id": "tabs",
      "props": {
        "items": [
          { "label": "쿠폰", "target": "coupon" },
          { "label": "혜택", "target": "benefits" },
          { "label": "상품", "target": "products" }
        ],
        "sticky": true
      }
    },
    {
      "type": "bannerCarousel",
      "id": "promo",
      "props": {
        "slides": [
          {
            "id": "slide-1",
            "title": "한정 수량 특가",
            "badge": "한정 수량",
            "periodLabel": "선착순 100명",
            "image": { "pc": "/globe.svg", "mo": "/window.svg", "alt": "한정 수량 특가" }
          },
          {
            "id": "slide-2",
            "title": "신상품 소모품",
            "href": "#products",
            "image": { "pc": "/file.svg", "mo": "/next.svg", "alt": "신상품" }
          }
        ],
        "autoplayInterval": 4000
      }
    },
    {
      "type": "couponDownload",
      "id": "coupon",
      "props": {
        "coupons": [
          { "id": "autumn-10000", "amount": 10000, "minPrice": 100000 },
          { "id": "autumn-5000", "amount": 5000 },
          { "id": "autumn-soldout-3000", "amount": 3000 }
        ]
      }
    },
    {
      "type": "benefitCards",
      "id": "benefits",
      "props": {
        "items": [
          {
            "icon": "cardDiscount",
            "title": "카드 할인",
            "description": "제휴 카드 결제 시 5% 추가 할인"
          },
          { "icon": "gift", "title": "사은품", "description": "10만원 이상 구매 시 사은품 증정" },
          {
            "icon": "membership",
            "title": "멤버십 적립",
            "description": "구매 금액의 3% 포인트 적립"
          }
        ]
      }
    },
    {
      "type": "productGrid",
      "id": "products",
      "props": {
        "columns": 4,
        "products": [
          {
            "id": "p1",
            "name": "무선 이어폰",
            "price": 89000,
            "image": { "src": "/globe.svg", "alt": "무선 이어폰" },
            "href": "#"
          },
          {
            "id": "p2",
            "name": "블루투스 스피커",
            "price": 39000,
            "originalPrice": 59000,
            "image": { "src": "/file.svg", "alt": "블루투스 스피커" },
            "href": "#"
          },
          {
            "id": "p3",
            "name": "보조 배터리",
            "price": 25000,
            "image": { "src": "/window.svg", "alt": "보조 배터리" },
            "href": "#"
          },
          {
            "id": "p4",
            "name": "케이블 세트",
            "price": 12000,
            "image": { "src": "/next.svg", "alt": "케이블 세트" },
            "href": "#"
          }
        ]
      }
    },
    {
      "type": "eventEntryForm",
      "id": "entry",
      "props": {
        "eventId": "autumn-sale-entry",
        "privacyNotice": "응모 처리를 위해 이름/연락처를 수집하며, 이벤트 종료 후 즉시 파기합니다. 동의합니다."
      }
    },
    {
      "type": "shareBar",
      "id": "share",
      "props": {
        "channels": ["kakao", "facebook", "url"]
      }
    },
    {
      "type": "noticeAccordion",
      "id": "notice",
      "props": {
        "items": [
          "쿠폰은 1인 1회 사용 가능합니다.",
          "본 행사는 당사 사정에 의해 예고 없이 변경/종료될 수 있습니다.",
          "일부 상품은 재고 소진 시 조기 종료될 수 있습니다."
        ]
      }
    }
  ]
}
